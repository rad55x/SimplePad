<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:AvaloniaEdit="using:AvaloniaEdit"
             xmlns:Local="using:SimplePad"
             x:Class="SimplePad.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <Local:ViewLocator/>
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!-- Common styles -->
        <!--| Window style -->
        <Style Selector="Window">
			<Setter Property="Background" Value="{DynamicResource DefaultBackgroundColor}"/>
        </Style>
        <!--|-->
        <!--| Label style -->
        <Style Selector="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!--|-->
        <!--| TextBlock style -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <!--|-->
        <!--| TextBox style -->
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="DimGray"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="DarkGray"/>
        </Style>
        <Style Selector="TextBox:focus:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="DimGray"/>
        </Style>
        <!--|-->
		<!--| TextEditor style -->
		<Style Selector="AvaloniaEdit|TextEditor">
			<Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Background" Value="{DynamicResource DarkTextEditorColor}"/>
		</Style>
		<!--|-->
        <!--| Button style -->
        <Style Selector="Button">
            <Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource DefaultButtonForeground}"/>
            <Setter Property="Background" Value="{DynamicResource DefaultButtonBackground}"/>
        </Style>
        <!--|-->
        <!--| RadioButton style -->
        <Style Selector="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style Selector="RadioButton:unchecked /template/ Ellipse#OuterEllipse">
			<Setter Property="Width" Value="12"/>
			<Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="White"/>
        </Style>
        <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
			<Setter Property="Width" Value="12"/>
			<Setter Property="Height" Value="12"/>
        </Style>
        <Style Selector="RadioButton:pointerover /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="DodgerBlue"/>
        </Style>
        <!--|-->
        <!--| CheckBox style -->
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style Selector="CheckBox.Common:unchecked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="DodgerBlue"/>
        </Style>
        <!--|-->
        <!--| Context menu style -->
        <Style Selector="ContextMenu">
			<Setter Property="Background" Value="{DynamicResource DefaultButtonBackground}"/>
        </Style>
        <!--|-->
        <!--| Flyout menu style -->
        <Style Selector="MenuFlyoutPresenter">
			<Setter Property="Background" Value="{DynamicResource DefaultButtonBackground}"/>
        </Style>
        <!--|-->
        <!--| Menu item style -->
        <Style Selector="MenuItem">
			<Setter Property="Background" Value="{DynamicResource DefaultButtonBackground}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!--|-->
        <!-- Tab item style -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style Selector="TabItem:disabled">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!--|-->
        <!--| Scrollbar style -->
        <Style Selector="ScrollBar">
			<Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <!--|-->
        <!---->
        <!-- Specific styles -->
        <!--| Button styles -->
        <Style Selector="Button.Red:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.Red:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1707A"/>
        </Style>
        <Style Selector="Button.Transparent">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.Transparent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.Transparent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!--|-->
        <!--| CheckBox styles -->
        <Style Selector="CheckBox.Common:unchecked /template/ Border#NormalRectangle">
			<Setter Property="Width" Value="12"/>
			<Setter Property="Height" Value="12"/>
        </Style>
        <Style Selector="CheckBox.Common:checked /template/ Border#NormalRectangle">
			<Setter Property="Width" Value="12"/>
			<Setter Property="Height" Value="12"/>
        </Style>
        <Style Selector="CheckBox.Common Panel">
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="20"/>
        </Style>
        <!--|-->
        <!--| Menu item styles -->
        <Style Selector="MenuItem.Unclickable">
			<Setter Property="Opacity" Value="0.5"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
        <!--|-->
        <!---->
        <Style Selector="Svg">
            <Setter Property="Css" Value="{DynamicResource DefaultSvgColor}"/>
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <!-- Menus -->
            <MenuFlyout x:Key="TextEditorMenu" Placement="BottomEdgeAlignedLeft" PlacementGravity="BottomLeft" OverlayDismissEventPassThrough="True" Opened="OnTextEditorMenuOpened">
                <MenuItem Header="Undo" InputGesture="Ctrl+Z" Click="OnTextEditorUndo"/>
			    <MenuItem Header="Redo" InputGesture="Ctrl+Y" Click="OnTextEditorRedo"/>
                <Separator/>
			    <MenuItem Header="Cut" InputGesture="Ctrl+X" Click="OnTextEditorCut"/>
			    <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="OnTextEditorCopy"/>
			    <MenuItem Header="Paste" InputGesture="Ctrl+V" Click="OnTextEditorPaste"/>
			    <MenuItem Header="Delete" InputGesture="Delete" Click="OnTextEditorDelete"/>
                <Separator/>
			    <MenuItem Header="Select all" InputGesture="Ctrl+A" Click="OnTextEditorSelectAll"/>
            </MenuFlyout>
            <!---->
            <!-- Colors -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DefaultBorderColor">#FFBABABA</SolidColorBrush>
                    <SolidColorBrush x:Key="DefaultForegroundColor">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="DefaultBackgroundColor">#FFE7E7E7</SolidColorBrush>
                    <SolidColorBrush x:Key="DefaultButtonForeground">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="DefaultButtonBackground">#FFDFDFDF</SolidColorBrush>
		            <SolidColorBrush x:Key="TextEditorColor">#FFE7E7E7</SolidColorBrush>
		            <SolidColorBrush x:Key="DarkTextEditorColor">White</SolidColorBrush>
                    <x:String x:Key="DefaultSvgColor">.cls-1 { fill: #000000; }</x:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DefaultBorderColor">#FF55BBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="DefaultForegroundColor">White</SolidColorBrush>
                    <SolidColorBrush x:Key="DefaultBackgroundColor">#FF202020</SolidColorBrush>
                    <SolidColorBrush x:Key="DefaultButtonForeground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="DefaultButtonBackground">#FF2F2F2F</SolidColorBrush>
		            <SolidColorBrush x:Key="TextEditorColor">#FF151515</SolidColorBrush>
		            <SolidColorBrush x:Key="DarkTextEditorColor">#FF101010</SolidColorBrush>
                    <x:String x:Key="DefaultSvgColor">.cls-1 { fill: #ffffff; }</x:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!---->
        </ResourceDictionary>
    </Application.Resources>
</Application>